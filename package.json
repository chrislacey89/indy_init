{
	"name": "two-hops",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 3000",
		"generate-routes": "tsr generate",
		"build": "vite build",
		"preview": "pnpm run build && vite preview",
		"deploy": "pnpm run build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --passWithNoTests",
		"lint": "biome check .",
		"prepare": "lefthook install",
		"preinstall": "npx only-allow pnpm"
	},
	"dependencies": {
		"@ai-sdk/google": "^4.0.113",
		"@effect/ai-openai": "4.1.2",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-devtools": "0.10.14",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-router-devtools": "1.167.2",
		"@tanstack/react-start": "1.169.4",
		"ai": "^7.0.164",
		"d3-geo": "^3.1.2",
		"drizzle-orm": "^0.45.4",
		"effect": "4.1.2",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tailwindcss": "^4.1.18",
		"topojson-client": "^3.1.0",
		"us-atlas": "^3.0.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.6",
		"@cloudflare/vite-plugin": "^1.26.0",
		"@tailwindcss/typography": "^0.5.16",
		"@tanstack/devtools-vite": "0.8.6",
		"@tanstack/router-cli": "^1.132.0",
		"@types/d3-geo": "^3.1.1",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^22.10.2",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@types/topojson-client": "^3.1.5",
		"@types/topojson-specification": "^1.0.5",
		"@vitejs/plugin-react": "^6.0.1",
		"drizzle-kit": "^0.31.11",
		"lefthook": "^2.2.2",
		"typescript": "^6.0.2",
		"vite": "^8.0.0",
		"vitest": "^5.1.0",
		"wrangler": "^4.158.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"lightningcss",
			"sharp",
			"workerd"
		],
		"overrides": {
			"postcss-selector-parser": ">=6.1.5",
			"@esbuild-kit/core-utils>esbuild": ">=0.25.0"
		}
	},
	"packageManager": "pnpm@10.32.1"
}
